# Common paths for all login and non-login shells

# rbenv setup
# Initialize once per shell; rbenv otherwise prepends its shims again.
if [[ ${RBENV_SHELL-} != bash ]] || ! declare -F rbenv >/dev/null; then
    eval "$(rbenv init - --no-rehash bash)"
fi

# Ripgrep config
export RIPGREP_CONFIG_PATH="$HOME/dev/dotfiles/tools/ripgrep"

# Added by Toolbox App
case ":$PATH:" in
    *":$HOME/.local/share/JetBrains/Toolbox/scripts:"*) ;;
    *) export PATH="$PATH:$HOME/.local/share/JetBrains/Toolbox/scripts" ;;
esac

# Java SDK
export JAVA_HOME="$HOME/.jdks/jbr-25.0.4.1"
case ":$PATH:" in
    *":$JAVA_HOME/bin:"*) ;;
    *) export PATH="$JAVA_HOME/bin:$PATH" ;;
esac

# Android Studio
#export ANDROID_HOME=/home/greg/Android/Sdk
#export ANDROID_EMU=$ANDROID_HOME/emulator
#export ANDROID_TOOLS=$ANDROID_HOME/tools
#export ANDROID_PLATFORM_TOOLS=$ANDROID_HOME/platform-tools
#export PATH=$PATH:$ANDROID_HOME:$ANDROID_EMU:$ANDROID_TOOLS:$ANDROID_TOOLS/bin:$ANDROID_PLATFORM_TOOLS:$ANDROID_HOME/ndk-bundle

# npm global packages
case ":$PATH:" in
    *":$HOME/.npm-global/bin:"*) ;;
    *) export PATH="$HOME/.npm-global/bin:$PATH" ;;
esac

# fix for QMK, Python PIP and claude
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

